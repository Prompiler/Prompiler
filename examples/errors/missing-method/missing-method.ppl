// Compile-time error: a class that fails to satisfy an interface because
// it is missing a required method signature.

interface Shape {
  name: string
  func area(): float
}

class Square {
  name: string
  side: float
}

func describe(s: Shape): string {
  return s.name
}

template MissingMethod {
  variables {
    sq: Square
  }

  prompt {
    {{ describe(sq) }}
  }
}
