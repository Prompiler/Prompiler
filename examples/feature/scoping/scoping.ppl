// Tests lexical scope at three levels: template variables (outermost,
// immutable), function parameters / function-level `var` (intermediate), and
// block-scoped `var` (innermost). A local `var` shadows an outer name without
// mutating it.

func demo(n: int): int {
  var x = n                 // function-level binding
  if (x > 0) {
    var x = x + 1           // block-scoped binding shadows outer `x`
    x = x * 2               // mutates only the inner `x`
  }
  return x                  // outer `x` is unchanged (== n)
}

template Scoping {
  variables {
    n: int                  // template variable (immutable)
  }

  prompt {
    Global: {{ n }}
    Scoped: {{ demo(n) }}
  }
}
