import "base-structured-prompt.ppl"

template CodingAgent {
  description: "A coding-agent prompt built on the base structured prompt, appending an extra note into the note section"

  variables {
    Role: string
    Task: string
    Notes: string = `1. Use subagents for exploration, feature engineering (subagent driven development) and review to preserve what you have on context.
2. Ask your subagents to follow test driven development, write the tests for the expected behaviour before starting implementation.
3. Make use of git worktrees and branch off the latest commit on the current branch.
4. For documentation and code comments, make use of Simplified Technical English and keep comments short and concise.
`
    extra_note: string
  }

  prompt {
    {{ include BaseStructuredPrompt(Role: Role, Task: Task, Notes: Notes + "\n" + extra_note) }}
  }
}
