// Demonstrates the standard library: `range`, `join`, and the four
// explicit casts `int` / `float` / `string` / `bool`.

template StandardLibrary {
  variables {
    numbers: int[]
    parts: string[]
  }

  prompt {
    Join: {{ join(parts, " | ") }}
    Range:
    {% for i in range(numbers.length) %}
    {{ i }}: {{ numbers[i] }}
    {% end %}
    Int: {{ int("42") }}
    Float: {{ float("3.14") }}
    Str: {{ string(true) }}
    Bool: {{ bool("true") }}
  }
}
